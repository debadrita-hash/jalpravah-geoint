{
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/logo.png"
    },
    {
      "source": "/builder",
      "destination": "/builder.html"
    },
    {
      "source": "/satellite",
      "destination": "/satellite.html"
    },
    {
      "source": "/run/([^/]+)/",
      "destination": "/api/proxy?__p=/run/$1/"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__p=/api/:path*"
    },
    {
      "source": "/run/:path*",
      "destination": "/api/proxy?__p=/run/:path*"
    },
    {
      "source": "/satellite-files/:path*",
      "destination": "/api/proxy?__p=/satellite-files/:path*"
    }
  ],
  "headers": [
    {
      "source": "/run/(.*)/files/(.*)\\.(tif|zip|kml|json|shp|shx|dbf|prj|cpg)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}